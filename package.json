{
  "name": "@dantehemerson/react-body-shape",
  "version": "0.1.0-rc.2",
  "description": "A measurement-driven, interactive 3D human body component for React.",
  "type": "module",
  "license": "MIT AND CC0-1.0",
  "author": "Dante Hemerson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dantehemerson/body-shape.git"
  },
  "homepage": "https://github.com/dantehemerson/body-shape#readme",
  "bugs": "https://github.com/dantehemerson/body-shape/issues",
  "keywords": [
    "react",
    "threejs",
    "body",
    "measurements",
    "3d",
    "visualizer"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "src/assets/human.provenance.json"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsup && tsc -p tsconfig.demo.json --noEmit && vite build",
    "build:lib": "tsup",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.demo.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "prepack": "npm run build:lib",
    "release:validate": "node scripts/validate-release.mjs",
    "assets:prepare": "node scripts/prepare-human-assets.mjs"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20",
    "react-dom": ">=19.0.0 <20",
    "three": ">=0.170.0 <1"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^5.1.1"
  }
}
